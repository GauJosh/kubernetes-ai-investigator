#!/usr/bin/env bash
# kubectl plugin: expose the Kubernetes AI Investigator (`kai`) as `kubectl kai ...`.
#
# This is not a plugin framework and does not add one -- kubectl discovers plugins natively:
# any executable file on PATH named `kubectl-<name>` becomes runnable as `kubectl <name>`, with
# every argument after the plugin name forwarded verbatim. This script does exactly one thing:
# it execs the already-installed `kai` (or its `investigate` alias) with those same arguments,
# completely unchanged. It adds no behavior, no flags, and no state of its own.
#
# Install:
#   1. Install kai itself first (see the main README's Installation section) -- this plugin
#      does nothing on its own; it only makes kubectl aware of an already-working `kai`.
#   2. Put this file on PATH as `kubectl-kai` and make it executable:
#        cp integrations/kubectl/kubectl-kai /usr/local/bin/kubectl-kai
#        chmod +x /usr/local/bin/kubectl-kai
#   3. Confirm kubectl sees it: `kubectl plugin list` should now include kubectl-kai.
#
# Usage -- identical to `kai` itself, just invoked through kubectl:
#   kubectl kai pod <name> -n <namespace> [kai options...]
#   kubectl kai pod rag-service -n devops-genai
#   kubectl kai pod my-pod -n my-ns --from-bundle saved-bundle.json
#
# Requires a POSIX shell (bash). On native Windows, kubectl.exe's plugin lookup only recognizes
# real Windows executables (.exe/.bat/.cmd) -- it will NOT discover this script as a plugin even
# from Git Bash, even once it's chmod +x'd. The `kubectl kai ...` plugin form only works on
# Windows via WSL, using WSL's own kubectl (see the main README's kubectl plugin integration
# section for exact steps). Outside WSL, skip this script and call `kai`/`investigate` directly
# instead -- the CLI itself has no such requirement and already works natively on Windows.

set -euo pipefail

if command -v kai >/dev/null 2>&1; then
  exec kai "$@"
elif command -v investigate >/dev/null 2>&1; then
  exec investigate "$@"
else
  echo "error: 'kai' is not installed or not on PATH -- install it first (pip install -e \".[dev]\" from the kubernetes-ai-investigator repo; see its README's Installation section), then re-run 'kubectl kai ...'." >&2
  exit 1
fi
